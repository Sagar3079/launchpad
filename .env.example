# Anthropic API key (OPTIONAL).
# Without it, LaunchPad runs in deterministic "template mode" and still works.
# With it, answers are written by the Anthropic Messages API (model claude-opus-4-8).
ANTHROPIC_API_KEY=

# Kiro API key (OPTIONAL) — fallback model for the co-browse fill, and powers
# the extension's default model via /api/agent-generate (server/kiro.js).
# Format: ksk_...
KIRO_API_KEY=

# Scalemax API key (OPTIONAL) — PRIMARY model backend for the co-browse fill.
# OpenAI-compatible (DeepSeek V4 Flash). If set, the fill uses this first and
# falls back to Kiro. Format: sm_live_...
SCALEMAX_API_KEY=
# Override the Scalemax endpoint / model if needed (defaults shown):
SCALEMAX_BASE_URL=https://api.scalemax.pro/token/v1
SCALEMAX_MODEL=deepseek-v4-flash

# Steel.dev API key (OPTIONAL) — enables the Live Co-browse feature
# (/cobrowse.html): a cloud browser you log into by hand while the server
# fills the form. Get one at https://steel.dev. Format: ste-...
STEEL_API_KEY=

# Co-browse proxy (OPTIONAL). Stealth mode (free) already loads Google/MS
# pages. A residential proxy is what stops reCAPTCHA from looping in the cloud
# browser. Two ways:
#  (a) Bring your own cheap residential proxy (e.g. IPRoyal ~$1) — set the full
#      URL here; no Steel balance needed. Format:
#      STEEL_PROXY_URL=http://USER:PASS@geo.iproyal.com:12321
#      (IPRoyal country targeting: put -country-in in the username)
#  (b) Steel's own proxy — needs >= $10 Steel balance; set STEEL_USE_PROXY=true.
STEEL_PROXY_URL=
STEEL_USE_PROXY=
STEEL_PROXY_COUNTRY=IN

# Session secret for login cookies (set in production so logins survive restarts).
SESSION_SECRET=

# Protects /api/agent-generate and /api/fill-payload in production.
AGENT_TOKEN=

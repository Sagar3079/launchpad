# Anthropic API key (OPTIONAL).
# Without it, LaunchPad runs in deterministic "template mode" and still works.
# With it, answers are written by the Anthropic Messages API (model claude-opus-4-8).
ANTHROPIC_API_KEY=

# Kiro API key (OPTIONAL) — powers the extension's default model via the
# /api/agent-generate proxy (server/kiro.js). Format: ksk_...
KIRO_API_KEY=

# Steel.dev API key (OPTIONAL) — enables the Live Co-browse feature
# (/cobrowse.html): a cloud browser you log into by hand while the server
# fills the form. Get one at https://steel.dev. Format: ste-...
STEEL_API_KEY=

# Session secret for login cookies (set in production so logins survive restarts).
SESSION_SECRET=

# Protects /api/agent-generate and /api/fill-payload in production.
AGENT_TOKEN=
